# Copie para ".env" e preencha. O .env NUNCA vai para o git.

APP_ENV=development
HTTP_ADDR=127.0.0.1:8080

# Postgres embutido (desenvolvimento): liga sozinho com a API, só em localhost
EMBEDDED_PG=true
EMBEDDED_PG_DIR=.data
EMBEDDED_PG_PORT=5433
DB_NAME=bizly

# Gere senhas aleatórias, ex. no Git Bash:  openssl rand -hex 24
DB_OWNER_USER=bizly_owner
DB_OWNER_PASSWORD=
DB_APP_USER=bizly_app
DB_APP_PASSWORD=

# Produção (EMBEDDED_PG=false): URLs vindas do provedor do banco
# OWNER_DATABASE_URL=postgres://dono:senha@host:5432/bizly?sslmode=require
# APP_DATABASE_URL=postgres://bizly_app:senha@host:5432/bizly?sslmode=require
