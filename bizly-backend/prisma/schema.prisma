generator client {
    provider = "prisma-client-py"
}

datasource db {
    provider = "sqlite"
    url      = "file:./dev.db"
}

model Company {
    id             String         @id @default(uuid())
    name           String
    slug           String?        @unique
    users          User[]
    customers      Customer[]
    services       Service[]
    appointments   Appointment[]
    createdAt      DateTime       @default(now()) @map("created_at")
    updatedAt      DateTime       @updatedAt @map("updated_at")
    availabilities Availability[]

    @@map("companies")
}

model User {
    id           String        @id @default(uuid())
    name         String
    email        String        @unique
    password     String
    role         String        @default("ADMIN") // change String -> Role and "Admin" -> Admin when migrating to a real db provider
    companyId    String        @map("company_id")
    company      Company       @relation(fields: [companyId], references: [id])
    appointments Appointment[]
    createdAt    DateTime      @default(now()) @map("created_at")
    updatedAt    DateTime      @updatedAt @map("updated_at")

    @@map("users")
}

model Availability {
    id        String @id @default(uuid())
    dayOfWeek Int
    startTime String
    endTime   String

    companyId String  @map("company_id")
    company   Company @relation(fields: [companyId], references: [id])

    @@map("availabilities")
}

model Customer {
    id           String        @id @default(uuid())
    name         String
    email        String
    phone        String?
    status       String        @default("ACTIVE")
    companyId    String        @map("company_id")
    company      Company       @relation(fields: [companyId], references: [id])
    createdAt    DateTime      @default(now()) @map("created_at")
    updatedAt    DateTime      @updatedAt @map("updated_at")

    @@unique([email, companyId])
    @@map("customers")
}

model Service {
    id           String        @id @default(uuid())
    name         String
    description  String?
    duration     Int
    price        Float         @default(0.0)
    companyId    String        @map("company_id")
    company      Company       @relation(fields: [companyId], references: [id])
    appointments Appointment[]
    createdAt    DateTime      @default(now()) @map("created_at")
    updatedAt    DateTime      @updatedAt @map("updated_at")

    @@map("services")
}

model Appointment {
    id             String   @id @default(uuid())
    startTime      DateTime @map("start_time")
    endTime        DateTime @map("end_time")
    status         String   @default("PENDING") // same thing String -> Status and "PENDING" -> PENDING
    priceAtBooking Float    @map("price_at_booking")

    companyId String  @map("company_id")
    company   Company @relation(fields: [companyId], references: [id])

    userId String @map("user_id")
    user   User   @relation(fields: [userId], references: [id])

    clientName String @map("client_name")

    serviceId String  @map("service_id")
    service   Service @relation(fields: [serviceId], references: [id])

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("appointments")
}

