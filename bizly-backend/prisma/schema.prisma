generator client {
    provider = "prisma-client-py"
}

datasource db {
    provider = "sqlite"
    url      = "file:./dev.db"
}

model Company {
    id             String         @id @default(uuid())
    name           String
    slug           String?        @unique

    // business profile
    email          String?
    phone          String?
    address        String?
    website        String?
    taxId          String?        @map("tax_id")

    // preferences
    currency        String        @default("BRL")
    timezone        String        @default("America/Sao_Paulo")
    defaultDuration Int           @default(60) @map("default_duration")

    users          User[]
    expenses       Expense[]
    incomes        Income[]
    customers      Customer[]
    services       Service[]
    appointments   Appointment[]
    createdAt      DateTime       @default(now()) @map("created_at")
    updatedAt      DateTime       @updatedAt @map("updated_at")
    availabilities Availability[]

    @@map("companies")
}

model User {
    id           String        @id @default(uuid())
    name         String
    email        String        @unique
    password     String
    role         String        @default("ADMIN") // change String -> Role and "Admin" -> Admin when migrating to a real db provider
    companyId    String        @map("company_id")
    company      Company       @relation(fields: [companyId], references: [id])
    appointments Appointment[]
    createdAt    DateTime      @default(now()) @map("created_at")
    updatedAt    DateTime      @updatedAt @map("updated_at")

    @@map("users")
}

model Availability {
    id        String @id @default(uuid())
    dayOfWeek Int
    startTime String
    endTime   String

    companyId String  @map("company_id")
    company   Company @relation(fields: [companyId], references: [id])

    @@unique([companyId, dayOfWeek])
    @@map("availabilities")
}

model Customer {
    id           String        @id @default(uuid())
    name         String
    email        String
    phone        String?
    status       String        @default("ACTIVE")
    companyId    String        @map("company_id")
    company      Company       @relation(fields: [companyId], references: [id])
    appointments Appointment[]
    createdAt    DateTime      @default(now()) @map("created_at")
    updatedAt    DateTime      @updatedAt @map("updated_at")

    @@unique([email, companyId])
    @@map("customers")
}

model Service {
    id           String        @id @default(uuid())
    name         String
    description  String?
    duration     Int
    price        Float         @default(0.0)
    companyId    String        @map("company_id")
    company      Company       @relation(fields: [companyId], references: [id])
    appointments Appointment[]
    createdAt    DateTime      @default(now()) @map("created_at")
    updatedAt    DateTime      @updatedAt @map("updated_at")

    @@map("services")
}

model Expense {
    id          String   @id @default(uuid())
    description String
    category    String   @default("OTHER") // RENT, SALARIES, SUPPLIES, MARKETING, UTILITIES, TAXES, OTHER
    amount      Float
    date        DateTime

    companyId String  @map("company_id")
    company   Company @relation(fields: [companyId], references: [id])

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@index([companyId, date])
    @@map("expenses")
}

// Revenue registered by hand (product sales, one-off services, anything outside the schedule)
model Income {
    id          String   @id @default(uuid())
    description String
    category    String   @default("OTHER") // SERVICES, PRODUCTS, SUBSCRIPTIONS, OTHER
    amount      Float
    date        DateTime

    companyId String  @map("company_id")
    company   Company @relation(fields: [companyId], references: [id])

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@index([companyId, date])
    @@map("incomes")
}

model Appointment {
    id             String   @id @default(uuid())
    startTime      DateTime @map("start_time")
    endTime        DateTime @map("end_time")
    status         String   @default("SCHEDULED") // SCHEDULED, CONFIRMED, COMPLETED, CANCELLED, NO_SHOW
    priceAtBooking Float    @map("price_at_booking")
    notes          String?

    companyId String  @map("company_id")
    company   Company @relation(fields: [companyId], references: [id])

    userId String @map("user_id")
    user   User   @relation(fields: [userId], references: [id])

    // snapshot of the name at booking time; also used for walk-ins without a client record
    clientName String @map("client_name")

    customerId String?   @map("customer_id")
    customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

    serviceId String  @map("service_id")
    service   Service @relation(fields: [serviceId], references: [id])

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@index([companyId, startTime])
    @@map("appointments")
}

